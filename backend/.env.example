# ========================================
# 学迹 / Xueji 后端环境变量示例
# 复制为 .env, 填入实际值
# ========================================

# 应用
APP_NAME=学迹 / Xueji
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# 数据库 (本地)
# 默认连 xueji 用户 / xueji 库, 密码同用户名 (本地 dev 用)
DATABASE_URL=postgresql+psycopg2://xueji:xueji@localhost:5432/xueji

# CORS (本地开发)
# CORS_ORIGINS=["http://localhost:3000"]

# JWT
# 生产环境必须改成随机 256-bit 字符串!
JWT_SECRET=dev-only-secret-change-in-production-please-use-random-256-bit-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# 注册邀请码 (可选)
# 留空 = 任何人都能注册 (dev 模式)
# 填了 = 只有持邀请码的人能注册 (生产或半开放用)
# 多个用逗号分隔, 例如: INVITE_CODES=stone-family,zhangsan-2026
# INVITE_CODES=

# 阿里云 OSS
# ALIYUN_OSS_ACCESS_KEY_ID=your_key
# ALIYUN_OSS_ACCESS_KEY_SECRET=your_key_secret
# ALIYUN_OSS_BUCKET=xueji-images
# ALIYUN_OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
# ALIYUN_OSS_CDN_DOMAIN=cdn.your-domain.com

# 阿里云 OCR
# ALIYUN_OCR_ACCESS_KEY_ID=your_key
# ALIYUN_OCR_ACCESS_KEY_SECRET=your_key_secret
# ALIYUN_OCR_REGION=cn-shanghai

# 智谱 GLM (https://open.bigmodel.cn)
# ZHIPU_API_KEY=your_zhipu_api_key
ZHIPU_MODEL=glm-4-flash

# 学习设置
DAILY_STUDY_LIMIT_MINUTES=30
LOCK_AT_NIGHT=true
LOCK_TIME=21:00

# 错题复习间隔 (天, 4h = 0.17)
REVIEW_INTERVALS_DAYS=[0.17, 1, 3, 7, 14, 30]
